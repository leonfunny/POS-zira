{
  "name": "zira-ai",
  "version": "1.0.26",
  "description": "Zira - Desktop application for connecting POS with thermal printers and barcode scanners",
  "author": "Zira AI <contact@zira-ai.com>",
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:app": "concurrently -k \"npm run dev:main\" \"npm run dev:renderer\" \"powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-electron.ps1\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "build": "npm run typecheck:renderer && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:metadata": "node scripts/generate-build-metadata.mjs",
    "build:android:web": "vite build --config vite.android.config.ts",
    "dev:android:live": "vite --config vite.android.live.config.ts",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "postinstall": "echo 'Skipping native rebuild for cross-platform build'",
    "scrape:fb": "node scripts/facebook-scraper.js",
    "scrape:fb:ts": "npx ts-node scripts/facebook-scraper.ts",
    "scrape:fb:stealth": "node scripts/facebook-scraper-stealth.js",
    "test": "vitest run",
    "test:boundaries": "vitest run tests/cross-platform-boundary-verifier.test.ts",
    "test:production-readiness": "vitest run tests/production-readiness-gate.test.ts",
    "gate:production-readiness": "node scripts/verify-production-readiness.mjs",
    "test:android:boundaries:source": "node scripts/verify-cross-platform-boundaries.mjs --root . --entry src/renderer/android-pos/main.ts --tsconfig tsconfig.android.json",
    "test:android:boundaries:bundle": "node scripts/verify-cross-platform-boundaries.mjs --root . --entry src/renderer/android-pos/main.ts --tsconfig tsconfig.android.json --bundle-dir dist/android-web",
    "test:android:boundaries:native-assets": "node scripts/verify-cross-platform-boundaries.mjs --root . --entry src/renderer/android-pos/main.ts --tsconfig tsconfig.android.json --bundle-dir android-pos/app/src/main/assets/public",
    "test:android:boundaries": "npm run test:android:boundaries:source && npm run build:android:web && npm run test:android:boundaries:bundle",
    "test:android:policy": "vitest run tests/android-stage1-policy.test.ts",
    "test:android:stage2": "vitest run tests/android-stage2-catalog.test.ts",
    "test:android:responsive": "node scripts/verify-android-responsive.mjs",
    "android:sync": "npm run test:android:boundaries && cap sync android && node scripts/normalize-android-generated.mjs && npm run test:android:boundaries:native-assets",
    "android:build:verify": "npm run android:sync && npm run test:android:stage2 && npm run test:android:responsive && node scripts/run-android-build.mjs",
    "android:build:live": "node scripts/build-android-live.mjs",
    "android:preflight": "node scripts/verify-android-toolchain.mjs",
    "test:android:parity": "vitest run tests/android-preload-surface-parity.test.ts tests/android-shell-props-parity.test.tsx tests/android-order-dto-parity.test.ts",
    "test:android:manifests": "node scripts/verify-android-manifests.mjs",
    "test:android:instrumentation": "node scripts/run-android-instrumentation.mjs",
    "test:android:reinstall": "node scripts/run-android-reinstall-probe.mjs",
    "test:build-metadata": "vitest run tests/build-metadata.test.ts",
    "test:ci:build-only-policy": "vitest run tests/build-only-ci-policy.test.ts && node scripts/verify-build-only-ci.mjs",
    "test:ci:windows-package-preflight": "node scripts/verify-build-only-ci.mjs --json --fail-on-r12",
    "test:watch": "vitest",
    "smoke:self-checkout": "vitest run tests/smoke-self-checkout.test.ts --reporter=verbose",
    "check:design": "bash scripts/check-design-tokens.sh",
    "test:css-baseline": "node scripts/verify-css-baseline.mjs --scope=pos",
    "test:css-baseline:strict": "node scripts/verify-css-baseline.mjs --scope=pos --strict"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "bonjour-service": "^1.4.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "grammy": "^1.21.0",
    "lucide-react": "^0.563.0",
    "openai": "^4.77.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react-zoom-pan-pinch": "^3.7.0",
    "rebrowser-playwright-core": "^1.52.0",
    "socket.io-client": "^4.8.1",
    "sql.js": "^1.13.0",
    "winston": "^3.17.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.982.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.11.0",
    "playwright": "^1.58.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.0.18",
    "yaml": "2.9.0"
  },
  "build": {
    "appId": "com.zira-ai.agent",
    "productName": "Zira",
    "copyright": "Copyright © 2024 Zira AI",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "npmRebuild": false,
    "afterPack": "scripts/patch-windows-exe-resources.js",
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "assets/icons/installer.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://img.zira.pl/downloads/"
      }
    ],
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "resources/drivers",
        "to": "drivers"
      },
      {
        "from": "resources/elzab",
        "to": "elzab"
      },
      {
        "from": "resources/thermal",
        "to": "thermal"
      }
    ]
  }
}
